        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return [];",
          "tbelScript": "// CONTRACT 11.7. Chi xu ly thiet bi room1-*\nvar r = [];\nvar name = metadata.deviceName;\nif (name == null || !name.startsWith('room1')) { return r; }\nif (msgType == 'INACTIVITY_EVENT') { r.add('offline'); return r; }\nif (msgType == 'ACTIVITY_EVENT') { r.add('online'); return r; }\nif (msg.temperature != null) {\n  if (msg.temperature >= 35) { r.add('tempHigh'); } else { r.add('tempOk'); }\n}\nif (msg.anomaly != null) {\n  if (msg.anomaly == true) { r.add('anomaly'); } else { r.add('anomalyOk'); }\n}\nif (msg.event_level == 'warning') { r.add('aiWarning'); }\nif (msg.presence != null) {\n  if (msg.presence == false && msg.fan_level == 0 && msg.light_on == false) { r.add('roomEmpty'); }\n  else if (msg.presence == true) { r.add('roomOccupied'); }\n}\nif (msg.fw_state == 'UPDATED') { r.add('otaSuccess'); }\nif (msg.fw_state == 'FAILED') { r.add('otaFailed'); }\nreturn r;"
        },
