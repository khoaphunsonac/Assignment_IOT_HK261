NODE_ENV=development
PORT=5000

# Database. Leave DB_HOST empty to run without a database.
DB_HOST=
DB_PORT=3306
DB_NAME=iot_assignment
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
