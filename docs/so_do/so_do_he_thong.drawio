<mxfile host="app.diagrams.net"><diagram id="he-thong" name="He thong"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Sơ đồ hệ thống BTL IoT nhóm 4: Giám sát &amp;amp; điều hòa phòng học (ESP-NOW + TinyML + OTA)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Nguồn: docs/CONTRACT.md v1.0 (mục 1, 3–13), chân đã xác nhận lab 10/11/2026. Màu = người phụ trách." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1500" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Node A: YoloUNO ESP32-S3 (cảm biến)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;container=0;fillColor=none;strokeWidth=2;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="330" height="560" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;DHT20&lt;/b&gt; nhiệt độ, độ ẩm&lt;br&gt;I2C 0x38 (SDA 11 / SCL 12), cổng I2C đỏ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="115" width="300" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;PIR&lt;/b&gt; chuyển động&lt;br&gt;GPIO 6, cổng D4-D3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="170" width="300" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Cảm biến ánh sáng&lt;/b&gt;&lt;br&gt;GPIO 1 (ADC1), cổng A1-A0, ADC thô 0–4095" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="225" width="300" height="48" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;TinyML&lt;/b&gt; (T04/T05): TFLite Micro&lt;br&gt;input [T, H] → anomaly_score 0–1&lt;br&gt;Model .h do &lt;b&gt;TV3 Phú train lại&lt;/b&gt; (#30)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="285" width="300" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Firmware Node A&lt;/b&gt; (T06, TV1 Minh, #26)&lt;br&gt;FreeRTOS: task đọc cảm biến 2 s, task ML, task gửi&lt;br&gt;Không nối WiFi: quét channel hotspot&lt;br&gt;Tự ghép cặp (broadcast PAIR_REQ), không hardcode MAC&lt;br&gt;Mất Node B ~10 s → quét lại channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="365" width="300" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Gói PktData (28 byte)&lt;/b&gt;&lt;br&gt;header: magic 0x31544C42 &#x27;BTL1&#x27;, version, type&lt;br&gt;seq, temperature, humidity, light, presence, anomaly_score&lt;br&gt;Gửi: unicast + gửi lại cùng seq ≤ 3 lần&lt;br&gt;(chốt sau test 11/11)&lt;br&gt;espnow_packet.h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="485" width="300" height="140" as="geometry"/></mxCell><mxCell id="c11" value="Node B: YoloUNO ESP32-S3 (chấp hành)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;container=0;fillColor=none;strokeWidth=2;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="360" height="560" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ESP-NOW RX&lt;/b&gt;: kiểm magic/version&lt;br&gt;seq trùng → bỏ, nhảy cóc → đếm espnow_loss&lt;br&gt;Node A mất → node_a_online=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="115" width="330" height="62" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Luật điều khiển&lt;/b&gt; auto / manual / offline (mục 13)&lt;br&gt;ngưỡng từ room1/config (retained), hysteresis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="185" width="330" height="62" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;LCD 16x2&lt;/b&gt;&lt;br&gt;I2C 0x21" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="255" width="160" height="48" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Quạt&lt;/b&gt; PWM 3 mức&lt;br&gt;GPIO 8, cổng D6-D5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605" y="255" width="160" height="48" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;LED RGB&lt;/b&gt; NeoPixel ×4: GPIO 10, cổng D8-D7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="310" width="330" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Webserver&lt;/b&gt; (T07, &lt;b&gt;TV4 Khoa&lt;/b&gt;, #33)&lt;br&gt;WebServer.h, gọi API control.h (mục 12)&lt;br&gt;control_set_fan / light / mode, get_state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="358" width="330" height="62" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;MQTT client&lt;/b&gt; PubSubClient (buffer 1024)&lt;br&gt;LWT room1/status, watchdog WiFi 10 s&lt;br&gt;WiFi.setSleep(false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="428" width="330" height="62" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;OTA client&lt;/b&gt; (T14)&lt;br&gt;tải .bin qua HTTP, kiểm sha256, rollback&lt;br&gt;báo room1/ota/status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="498" width="330" height="62" as="geometry"/></mxCell><mxCell id="c20" value="espressif32@6.9.0 (core 2.0.17) cho cả 2 node&lt;br&gt;Bí mật trong secrets.h (không commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="568" width="330" height="56" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;align=left;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;ESP-NOW&lt;/b&gt;&lt;br&gt;(T06)&lt;br&gt;2 s/gói" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="354" y="330" width="64" height="60" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Hotspot điện thoại&lt;/b&gt; &#x27;Fluoxetine&#x27;&lt;br&gt;2.4 GHz, dải 10.x (IP có thể đổi)&lt;br&gt;Node B + laptop cùng mạng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="240" height="70" as="geometry"/></mxCell><mxCell id="c24" value="Laptop (Windows): chạy toàn bộ phía Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;container=0;fillColor=none;strokeWidth=2;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="180" width="420" height="460" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Mosquitto&lt;/b&gt; broker :1883 (listener 0.0.0.0)&lt;br&gt;topic local &lt;b&gt;room1/#&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="215" width="390" height="62" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Gateway Python&lt;/b&gt; (T08/T09/T15, &lt;b&gt;TV2 Tuấn&lt;/b&gt;, #28)&lt;br&gt;bridge.py, paho-mqtt 1.6.1, token trong .env&lt;br&gt;• tách telemetry → room1-node-a / room1-node-b&lt;br&gt;• RPC CoreIOT ↔ room1/cmd (id tb-…, timeout 5 s)&lt;br&gt;• connect/disconnect thiết bị con, gửi room1/config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="290" width="390" height="120" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;HTTP server :8000&lt;/b&gt;&lt;br&gt;/fw/node_b_x.y.z.bin&lt;br&gt;(OTA, #29)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="420" width="190" height="62" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;AI&lt;/b&gt; sự kiện room1/event&lt;br&gt;(TV3 Phú)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="420" width="190" height="62" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Giao diện local Streamlit&lt;/b&gt; (T10, &lt;b&gt;TV3 Phú&lt;/b&gt;, #31)&lt;br&gt;đọc room1/#, gửi lệnh ui-… qua room1/cmd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="492" width="390" height="62" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;fake_node_b.py&lt;/b&gt; (TV2 Tuấn, #27, chỉ W1)&lt;br&gt;đóng vai Node B đúng mục 4–9, tắt khi có Node B thật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="845" y="566" width="390" height="62" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Topic MQTT local&lt;/b&gt; (CONTRACT mục 4–10)&lt;br&gt;Node B →: room1/telemetry (2 s), room1/cmd/resp,&lt;br&gt;room1/status (LWT), room1/ota/status&lt;br&gt;→ Node B: room1/cmd, room1/config (retained), room1/ota&lt;br&gt;Gateway: room1/gateway/status (LWT), room1/event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="70" width="380" height="100" as="geometry"/></mxCell><mxCell id="c32" value="MQTT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;align=left;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c18" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="room1/#" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="room1/#" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#d79b00;labelBackgroundColor=#ffffff;align=left;exitX=1;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="c25" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="HTTP GET .bin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;align=left;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="c27" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="CoreIOT: app.coreiot.io" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;container=0;fillColor=none;strokeWidth=2;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="1310" y="180" width="330" height="460" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Thiết bị&lt;/b&gt; (mục 11.1)&lt;br&gt;room1-gateway (Gateway)&lt;br&gt;room1-node-a: cảm biến + anomaly&lt;br&gt;room1-node-b: quạt/đèn/mode, RPC, OTA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1325" y="215" width="300" height="90" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Dashboard&lt;/b&gt; (T11, &lt;b&gt;TV4 Khoa&lt;/b&gt;, #32)&lt;br&gt;biểu đồ, nút setFan/setLight/setMode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1325" y="315" width="300" height="62" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;RuleChain + cảnh báo&lt;/b&gt; (T12/T13, TV4)&lt;br&gt;Change originator → RPC (slide thầy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1325" y="387" width="300" height="62" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Shared attribute&lt;/b&gt; ngưỡng&lt;br&gt;→ Gateway → room1/config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1325" y="459" width="300" height="48" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;OTA&lt;/b&gt; CoreIOT (T14)&lt;br&gt;cho thiết bị sau Gateway (đang kiểm, #29)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1325" y="517" width="300" height="48" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;MQTT Gateway API&lt;/b&gt; (mục 11): v1/gateway/telemetry,&lt;br&gt;connect | disconnect, rpc, attributes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1325" y="573" width="300" height="58" as="geometry"/></mxCell><mxCell id="c43" value="MQTT&lt;br&gt;(Internet)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;align=left;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c26" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Người dùng trong phòng&lt;/b&gt;: điện thoại vào hotspot&lt;br&gt;mở http://IP-Node-B (web local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="670" width="360" height="48" as="geometry"/></mxCell><mxCell id="c45" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#666666;labelBackgroundColor=#ffffff;align=left;exitX=0;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="c44" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Người dùng từ xa&lt;/b&gt;: trình duyệt / app CoreIOT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1310" y="670" width="330" height="48" as="geometry"/></mxCell><mxCell id="c47" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeWidth=2;strokeColor=#666666;labelBackgroundColor=#ffffff;align=left;exitX=1;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="c46" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Chú thích màu&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="380" height="20" as="geometry"/></mxCell><mxCell id="c49" value="TV1 Minh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="684" width="90" height="26" as="geometry"/></mxCell><mxCell id="c50" value="TV2 Tuấn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="115" y="684" width="90" height="26" as="geometry"/></mxCell><mxCell id="c51" value="TV3 Phú" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="684" width="90" height="26" as="geometry"/></mxCell><mxCell id="c52" value="TV4 Khoa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="305" y="684" width="90" height="26" as="geometry"/></mxCell><mxCell id="c53" value="Xám = linh kiện phần cứng. Vàng = hạ tầng mạng. Nét đứt = tạm thời hoặc tùy chọn." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="716" width="380" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>